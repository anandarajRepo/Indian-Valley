## A friendly villager with a bit of flavour and a farming tip.
position = Vector2(224, 128)
script = ExtResource("2")
npc_name = "Murugan"
dialogue = "Ah, the young one from the old farm!\nYour grandparents grew the sweetest watermelon in the valley.\nWater your crops every day, or they'll just sit there sulking.\nShip what you grow in the chest by the plot — Kavitha's cousin buys it overnight."
