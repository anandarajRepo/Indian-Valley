; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the engine allows in-plain text format.

config_version=5

[application]

config/name="Indian Valley"
config/description="A farming and life simulation game set in Viralpadi Valley, rural India"
config/version="0.9.0-rc1"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
boot_splash/bg_color=Color(0.094, 0.078, 0.047, 1)
config/icon="res://icon.svg"
config/tags=PackedStringArray("farming-sim", "life-sim", "india")

[autoload]

GameClock="*res://scripts/autoloads/GameClock.gd"
GameData="*res://scripts/autoloads/GameData.gd"
SaveManager="*res://scripts/autoloads/SaveManager.gd"
ItemDB="*res://scripts/autoloads/ItemDB.gd"
Calendar="*res://scripts/autoloads/Calendar.gd"
Relationships="*res://scripts/autoloads/Relationships.gd"
Weather="*res://scripts/autoloads/Weather.gd"
Quests="*res://scripts/autoloads/Quests.gd"
Audio="*res://scripts/autoloads/Audio.gd"
Settings="*res://scripts/autoloads/Settings.gd"

[indian_valley]

demo_build=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

